---
import { getContentSeo, getEmDashEntry, getSeoMeta } from "emdash";
import PageSections from "@/components/PageSections.astro";
import Base from "@/layouts/Base.astro";
import { getSiteUrl } from "@/lib/site-url";

const HOME_SLUG = "inicio";
const HOME_TITLE = "Marose · Cookies & postres artesanales — Cartagena";

const { entry: page, cacheHint } = await getEmDashEntry("pages", HOME_SLUG);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = page
	? getSeoMeta(page, { siteUrl: getSiteUrl(Astro.url.origin), path: "/" })
	: null;
const seoTitle = (page && getContentSeo(page)?.title) || HOME_TITLE;
---

<Base
	title={seoTitle}
	pageTitle={seoTitle}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={`${getSiteUrl(Astro.url.origin)}/`}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
>
	{
		page ? (
			<div {...page.edit.sections}>
				<PageSections value={page.data.sections ?? []} />
			</div>
		) : (
			<section class="mx-auto max-w-2xl px-6 py-32 text-center">
				<h1 class="font-velvet-serif text-heading text-blush-cream">Marose</h1>
				{Astro.locals.user && (
					<p class="mt-6 text-rose-mist">
						Publica una página con el slug “inicio” para mostrarla aquí.
					</p>
				)}
			</section>
		)
	}
</Base>
