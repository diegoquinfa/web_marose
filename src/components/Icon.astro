---
interface Props {
	name?: string | null;
	class?: string;
}

const { name, class: className } = Astro.props;

/**
 * Inline SVGs for the `how_to_order` icon selects. The first four step icons
 * are ported from the legacy `how-to-order.tsx`; "Entrega" and "Corazón" are
 * simple additions for the remaining select options.
 */
const ICONS: Record<string, string> = {
	Antojo: `
		<circle cx="12" cy="12" r="9" />
		<circle cx="9" cy="9.5" r="0.8" fill="currentColor" />
		<circle cx="14.5" cy="8.5" r="0.8" fill="currentColor" />
		<circle cx="15.5" cy="13.5" r="0.8" fill="currentColor" />
		<circle cx="10" cy="14.5" r="0.8" fill="currentColor" />`,
	Mensaje: `
		<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
		<path d="M8 9h8M8 12.5h5" />`,
	Confirmación: `
		<path d="M12 21C7 17.5 3.5 14 3.5 9.8 3.5 6.9 5.7 5 8.2 5c1.5 0 2.9.8 3.8 2 .9-1.2 2.3-2 3.8-2 2.5 0 4.7 1.9 4.7 4.8 0 4.2-3.5 7.7-8.5 11.2z" />
		<path d="M9 11.5l2 2 4-4" />`,
	Regalo: `
		<path d="M20 12v10H4V12" />
		<path d="M22 7H2v5h20V7z" />
		<path d="M12 22V7" />
		<path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" />
		<path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" />`,
	Entrega: `
		<path d="M3 8.5 12 4l9 4.5-9 4.5z" />
		<path d="M3 8.5V16l9 4.5" />
		<path d="M21 8.5V16l-9 4.5" />
		<path d="M12 13v7.5" />`,
	Calendario: `
		<rect x="3" y="5" width="18" height="16" rx="3" />
		<path d="M3 10h18M8 3v4M16 3v4" />
		<circle cx="12" cy="15" r="1" fill="currentColor" stroke="none" />`,
	Reloj: `
		<circle cx="12" cy="13" r="8" />
		<path d="M12 9v4l2.5 2M9.5 2h5" />`,
	Ubicación: `
		<path d="M12 21s-7-5.3-7-11a7 7 0 0 1 14 0c0 5.7-7 11-7 11z" />
		<circle cx="12" cy="10" r="2.5" />`,
	Corazón: `
		<path d="M12 21C7 17.5 3.5 14 3.5 9.8 3.5 6.9 5.7 5 8.2 5c1.5 0 2.9.8 3.8 2 .9-1.2 2.3-2 3.8-2 2.5 0 4.7 1.9 4.7 4.8 0 4.2-3.5 7.7-8.5 11.2z" />`,
};

const inner = name ? ICONS[name] : undefined;
---

{
	inner && (
		<svg
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.8"
			stroke-linecap="round"
			stroke-linejoin="round"
			class={className}
			aria-hidden="true"
			set:html={inner}
		/>
	)
}
