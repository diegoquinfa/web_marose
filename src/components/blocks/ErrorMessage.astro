---
import { type BlockComponentProps } from "emdash/ui";
import type { ErrorMessageBlock } from "@/components/blocks/types";
import WhatsappButton from "@/components/WhatsappButton.astro";
import { getBusinessInfo } from "@/lib/business";

type Props = BlockComponentProps<ErrorMessageBlock>;

const { value } = Astro.props;
const business = await getBusinessInfo();
---

<section
	id={value.anchor || undefined}
	class="flex min-h-[70vh] items-center justify-center bg-cocoa-noir px-4 py-16"
>
	<div class="relative mx-auto w-full max-w-2xl">
		<div
			class="relative overflow-hidden rounded-card bg-espresso-truffle px-8 py-14 text-center shadow-soft sm:px-14 sm:py-20"
		>
			<div
				class="mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full bg-deep-cocoa shadow-soft ring-1 ring-cocoa-hairline sm:h-28 sm:w-28"
			>
				<img
					src="/logos/logo-2.webp"
					alt=""
					class="h-16 w-16 rounded-full object-cover sm:h-20 sm:w-20"
				/>
			</div>

			<p class="font-velvet-serif text-[80px] font-medium leading-none text-rose-petal sm:text-[120px]">
				{value.code}
			</p>

			<h1 class="mt-4 text-balance font-velvet-serif text-heading-sm font-medium text-blush-cream sm:text-heading">
				{value.heading}
			</h1>

			{
				value.heading_script && (
					<p class="mt-3 font-dulce-script text-3xl text-rose-petal sm:text-4xl">
						{value.heading_script}
					</p>
				)
			}

			{
				value.body && (
					<p class="mx-auto mt-5 max-w-md text-pretty text-[17px] leading-relaxed text-rose-mist">
						{value.body}
					</p>
				)
			}

			<div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a
					href="/"
					class="inline-flex items-center justify-center rounded-pill border border-cocoa-hairline px-6 py-3.5 text-[17px] font-medium text-blush-cream transition-all duration-200 hover:-translate-y-0.5 hover:border-dusty-rose hover:text-rose-petal"
				>
					{value.home_label}
				</a>
				<WhatsappButton
					number={business.whatsappNumber}
					message={value.cta_message || business.whatsappDefaultMessage}
					label={value.cta_label ?? "Escríbenos"}
				/>
			</div>
		</div>
	</div>
</section>
