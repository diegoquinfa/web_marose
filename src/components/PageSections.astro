---
import { Blocks, defineBlockComponents } from "emdash/ui";
import About from "@/components/blocks/About.astro";
import CtaBanner from "@/components/blocks/CtaBanner.astro";
import ErrorMessage from "@/components/blocks/ErrorMessage.astro";
import Hero from "@/components/blocks/Hero.astro";
import HowToOrder from "@/components/blocks/HowToOrder.astro";
import MenuGrid from "@/components/blocks/MenuGrid.astro";
import Reviews from "@/components/blocks/Reviews.astro";
import TextBlock from "@/components/blocks/TextBlock.astro";
import type { MaroseBlock } from "@/components/blocks/types";

interface Props {
	/** The page's `sections` blocks field. Typed loosely until `emdash-env.d.ts` exists. */
	value?: unknown;
}

const { value } = Astro.props;

const components = defineBlockComponents<MaroseBlock>({
	hero: Hero,
	menu_grid: MenuGrid,
	reviews: Reviews,
	how_to_order: HowToOrder,
	about: About,
	cta_banner: CtaBanner,
	text_block: TextBlock,
	error_message: ErrorMessage,
});

const blocks = (Array.isArray(value) ? value : []) as MaroseBlock[];
---

<Blocks value={blocks} components={components} />
