{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "marose-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "marose-web-db",
			"database_id": "d0059fa5-704e-483b-ba5f-761140c720a8",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "marose-web-media",
		},
	],
	"kv_namespaces": [
		// EmDash object cache (marose-web-cache).
		{
			"binding": "CACHE",
			"id": "94a8111faf8a48f199c85141c1e77210",
		},
		// Astro sessions (marose-web-session), used by the Cloudflare adapter.
		{
			"binding": "SESSION",
			"id": "c8d7720381fc4877b4543fd8a1534c53",
		},
	],
	"send_email": [{ "name": "EMAIL" }],
	"images": {
		"binding": "IMAGES",
	},
	// Scheduled publishing, backups, and maintenance.
	"triggers": {
		"crons": ["* * * * *"],
	},
	"vars": {
		"EMDASH_SITE_URL": "https://marosectg.com",
	},
	"observability": {
		"enabled": true,
	},
	// Serve only on the custom domain: no duplicate workers.dev copy of the site/admin.
	"workers_dev": false,
	"routes": [{ "pattern": "marosectg.com", "custom_domain": true }],
	// Run the Worker next to the D1 primary (fill region after the database exists):
	// "placement": { "mode": "targeted", "region": "<d1-primary-region>" },
}
